rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function profile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }
    function active() {
      return request.auth != null && profile().get('isActive', true) != false;
    }
    function admin() { return active() && profile().role.lower() == 'admin'; }
    function analyst() { return active() && profile().role.lower() == 'analyst'; }
    function owns(data) {
      let key = profile().get('analystKey', profile().get('displayName', ''));
      return analyst() && key != '' &&
        (data.get('analista', '') == key || data.get('analyst', '') == key);
    }
    match /userProfiles/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || admin());
      allow list, write: if admin();
    }
    match /settings/{id} {
      allow read: if admin() || (analyst() && id in ['global','analystRules']);
      allow write: if admin();
    }
    match /invoices/{id} {
      allow read: if admin() || owns(resource.data);
      allow create: if admin() && request.resource.data.get('linkedPayoutRequestId', null) == null;
      allow delete: if admin() && resource.data.get('linkedPayoutRequestId', null) == null;
      // Linked amounts/states are immutable from browsers; only the service transitions them.
      allow update: if admin() && request.resource.data.get('linkedPayoutRequestId', null) == resource.data.get('linkedPayoutRequestId', null) &&
        (resource.data.get('linkedPayoutRequestId', null) == null ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoDeCobro','fechaCobro','updatedAt','updatedBy']));
    }
    match /analyst_invoices/{uid}/items/{id} {
      allow read: if admin() || (analyst() && uid == request.auth.uid);
      // Existing admin mirror synchronization remains supported. The service always
      // validates the authoritative invoice, never analyst mirror values.
      allow write: if admin();
    }
    match /payoutRequests/{id} {
      allow read: if admin() || (analyst() && resource.data.analystUid == request.auth.uid);
      allow write: if false;
      match /{subcollection}/{entry} {
        allow read: if subcollection in ['items','events'] && (admin() ||
          (analyst() && get(/databases/$(database)/documents/payoutRequests/$(id)).data.analystUid == request.auth.uid));
        allow write: if false;
      }
    }
    match /analystPayments/{id} {
      allow read: if admin() || (analyst() && resource.data.analystUid == request.auth.uid);
      allow write: if false;
    }
    // Jobs, counters, operation references and audit writes are server-only.
  }
}
